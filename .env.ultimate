# ===============================================
# ملف البيئة النهائي - نظام بنّاء اليمن
# ===============================================

# إعدادات التطبيق الأساسية
NODE_ENV=development
PORT=3000
APP_NAME="نظام بنّاء اليمن - النهائي"
LOG_LEVEL=info

# إعدادات قاعدة البيانات (PostgreSQL مع PostGIS)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/binaa_yemen
POSTGRES_DB=binaa_yemen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# إعدادات Redis للتخزين المؤقت
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# إعدادات MinIO لتخزين الملفات
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=binaa-files
MINIO_USE_SSL=false

# مفاتيح الأمان والتشفير
JWT_SECRET=ultimate-jwt-secret-key-2025-binaa-yemen-system
SESSION_SECRET=ultimate-session-secret-2025-binaa-yemen-system
BCRYPT_ROUNDS=12

# إعدادات الخادم والشبكة
TRUST_PROXY=true
ENABLE_CORS=true
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# إعدادات Puppeteer لإنتاج PDF
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--disable-web-security
ENABLE_PDF_GENERATION=true

# إعدادات التطوير والتصحيح
DEBUG_MODE=true
VERBOSE_LOGGING=true
ENABLE_HOT_RELOAD=true

# إعدادات الأداء
MAX_FILE_SIZE=50MB
UPLOAD_TIMEOUT=300000
DB_CONNECTION_TIMEOUT=30000
DB_QUERY_TIMEOUT=10000

# إعدادات التوطين
DEFAULT_LOCALE=ar
DEFAULT_TIMEZONE=Asia/Aden
RTL_SUPPORT=true

# إعدادات التكامل الخارجي (للمستقبل)
ENABLE_EMAIL_SERVICE=false
ENABLE_SMS_SERVICE=false
ENABLE_NOTIFICATIONS=true

# إعدادات الأمان المتقدمة
ENABLE_API_RATE_LIMITING=true
ENABLE_BRUTE_FORCE_PROTECTION=true
SESSION_TIMEOUT=3600000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# رسالة النجاح
SETUP_MESSAGE="تم تكوين نظام بنّاء اليمن النهائي بنجاح! 🚀"