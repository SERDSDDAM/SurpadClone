# ===============================================
# متغيرات البيئة للنشر المحلي - بنّاء اليمن
# تم الإعداد والتحديث: 10 سبتمبر 2025
# ===============================================

# إعدادات التطبيق الأساسية
NODE_ENV=development
PORT=3000
APP_PORT=3000

# إعدادات قاعدة البيانات PostgreSQL
POSTGRES_DB=binaa_local_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/binaa_local_db

# إعدادات Redis للجلسات والتخزين المؤقت
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# إعدادات MinIO لتخزين الملفات
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000

# إعدادات الأمان والمصادقة (للتطوير المحلي فقط)
JWT_SECRET=local-development-jwt-secret-key-not-for-production
SESSION_SECRET=local-development-session-secret-key-not-for-production

# إعدادات الخادم والشبكة
TRUST_PROXY=true
ENABLE_CORS=true
ENABLE_DEBUG=true

# إعدادات التسجيل والمراقبة
LOG_LEVEL=debug
LOG_DIR=./logs
ENABLE_API_DOCS=true
ENABLE_MONITORING=true
ENABLE_PROFILING=false

# إعدادات رفع الملفات
MAX_FILE_SIZE=200MB
UPLOAD_DIR=./temp-uploads
TEMP_DIR=/tmp

# إعدادات النظام المكاني GIS
DEFAULT_COORDINATE_SYSTEM=EPSG:4326
SUPPORTED_PROJECTIONS=EPSG:4326,EPSG:32638

# إعدادات المكونات - تفعيل جميع المكونات للتطوير
ENABLE_SURVEY_MODULE=true
ENABLE_PERMITS_MODULE=true
ENABLE_GIS_MODULE=true
ENABLE_REPORTS_MODULE=true
ENABLE_ADMIN_MODULE=true
ENABLE_WEBSOCKETS=true
ENABLE_REAL_TIME_SYNC=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_METRICS=true

# إعدادات خاصة بالبيئة اليمنية
DEFAULT_TIMEZONE=Asia/Aden
DEFAULT_LOCALE=ar_YE
DEFAULT_CURRENCY=YER
SUPPORTED_LANGUAGES=ar,en

# معلومات النسخة والنشر
APP_VERSION=2.0-local
BUILD_DATE=2025-09-10
ENVIRONMENT=local-development

# إعدادات الأداء للتطوير المحلي
DB_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=5
REQUEST_TIMEOUT=30000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000
SESSION_TIMEOUT=7200000

# مسارات النظام
LOGS_DIR=./logs
UPLOADS_DIR=./temp-uploads
ASSETS_DIR=./attached_assets

# تعطيل المكونات غير الضرورية في التطوير المحلي
PDF_SERVICE_ENABLED=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# إعدادات Docker المحلية
DOCKER_NETWORK=binaa-local-network
COMPOSE_PROJECT_NAME=binaa-local

# إعدادات التطوير السريع
HOT_RELOAD=true
WATCH_FILES=true
AUTO_RESTART=true