# ===============================================
# .dockerignore لنظام بنّاء اليمن
# ===============================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.node_repl_history

# Build outputs
dist/
build/
.next/
out/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# Logs
logs/
*.log
log/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/
public

# Vite build output
dist-ssr
*.local

# Rollup.js default build output
dist/

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore
.gitkeep

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
README*.md
*.md
docs/

# Tests
test/
tests/
__tests__/
spec/
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Development files
.editorconfig
.eslintrc*
.prettierrc*
tsconfig.json
jsconfig.json

# Temporary uploads (will be recreated)
temp-uploads/
uploads/

# Generated files
generated/

# Lock files (use npm ci instead)
package-lock.json
yarn.lock

# Database files
*.sqlite
*.sqlite3
*.db

# Backup files
*.backup
*.bak

# Archive files
*.zip
*.tar.gz
*.rar

# Large media files (should be in external storage)
*.mp4
*.avi
*.mov
*.mp3
*.wav

# Python (if any Python scripts exist)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Analysis and monitoring
.nyc_output/
coverage/
.coverage
htmlcov/

# Webpack
.webpack/

# Serverless
.serverless/

# FuseBox
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Prisma
prisma/migrations/