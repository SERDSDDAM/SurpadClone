# ===============================================
# متغيرات البيئة للنشر المحلي - بنّاء اليمن
# ===============================================

# إعدادات التطبيق الأساسية
NODE_ENV=development
PORT=5000
APP_PORT=5000

# إعدادات قاعدة البيانات PostgreSQL
POSTGRES_DB=binaa_yemen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/binaa_yemen

# إعدادات Redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# إعدادات MinIO لتخزين الملفات
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000

# إعدادات الأمان والمصادقة
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please
SESSION_SECRET=your-session-secret-key-change-in-production-please

# إعدادات الخادم والشبكة
TRUST_PROXY=true
ENABLE_CORS=true
ENABLE_DEBUG=true

# إعدادات Nginx (للإنتاج)
NGINX_PORT=80
NGINX_SSL_PORT=443

# إعدادات التسجيل
LOG_LEVEL=debug
LOG_DIR=./logs

# إعدادات رفع الملفات
MAX_FILE_SIZE=100MB
UPLOAD_DIR=./temp-uploads

# إعدادات البريد الإلكتروني (اختياري)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=no-reply@binaa.gov.ye

# إعدادات النظام المكاني GIS
DEFAULT_COORDINATE_SYSTEM=EPSG:4326
SUPPORTED_PROJECTIONS=EPSG:4326,EPSG:32638

# إعدادات التطوير والاختبار
ENABLE_API_DOCS=true
ENABLE_MONITORING=true
ENABLE_PROFILING=false

# معلومات النسخة والنشر
APP_VERSION=1.0.0
BUILD_DATE=2025-09-04
ENVIRONMENT=local

# إعدادات الأداء
DB_POOL_SIZE=20
REDIS_MAX_CONNECTIONS=10
REQUEST_TIMEOUT=30000

# مسارات النظام
TEMP_DIR=/tmp
LOGS_DIR=./logs
UPLOADS_DIR=./temp-uploads
ASSETS_DIR=./attached_assets

# إعدادات الأمان الإضافية
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
SESSION_TIMEOUT=3600000

# تفعيل المكونات الاختيارية
ENABLE_WEBSOCKETS=true
ENABLE_REAL_TIME_SYNC=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_METRICS=true

# إعدادات خاصة بنظام بنّاء اليمن
ENABLE_SURVEY_MODULE=true
ENABLE_PERMITS_MODULE=true
ENABLE_GIS_MODULE=true
ENABLE_REPORTS_MODULE=true
ENABLE_ADMIN_MODULE=true

# معايرة النظام للبيئة اليمنية
DEFAULT_TIMEZONE=Asia/Aden
DEFAULT_LOCALE=ar_YE
DEFAULT_CURRENCY=YER
SUPPORTED_LANGUAGES=ar,en