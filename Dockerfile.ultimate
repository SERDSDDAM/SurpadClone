# ===============================================
# Dockerfile النهائي - إصلاح مشكلة rollup نهائياً
# ===============================================

# استخدام Node.js 18 (مستقر مع WebSocket)
FROM node:18-alpine

# إعداد متغيرات البيئة لحل مشاكل npm وrollup
ENV NODE_ENV=development
ENV PORT=3000
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV NPM_CONFIG_OPTIONAL=true
ENV NPM_CONFIG_PLATFORM=linux
ENV NPM_CONFIG_ARCH=x64
ENV NPM_CONFIG_TARGET_LIBC=musl

# تثبيت أدوات النظام المطلوبة
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    curl \
    postgresql-client \
    && rm -rf /var/cache/apk/*

# إعداد مجلد العمل
WORKDIR /app

# نسخ package files أولاً للاستفادة من Docker cache
COPY package*.json ./
COPY tsconfig.json ./

# تحديث npm إلى أحدث إصدار وتنظيف cache
RUN npm install -g npm@latest && \
    npm cache clean --force && \
    npm config set fund false && \
    npm config set audit false

# تثبيت rollup platform-specific packages بشكل صريح لحل المشكلة
RUN npm install @rollup/rollup-linux-x64-musl --save-optional --ignore-scripts || \
    npm install @rollup/rollup-linux-x64-gnu --save-optional --ignore-scripts || \
    npm install rollup --save-optional --ignore-scripts || true

# تثبيت التبعيات الأساسية مع إجبار optional dependencies
RUN npm ci --include=optional --ignore-scripts || \
    npm install --include=optional --ignore-scripts || \
    npm install --only=production --ignore-scripts

# تثبيت أدوات إضافية
RUN npm install tsconfig-paths tsx

# تثبيت أدوات التطوير العالمية
RUN npm install -g drizzle-kit

# نسخ كامل المصدر
COPY . .

# إنشاء المجلدات المطلوبة
RUN mkdir -p temp-uploads attached_assets logs && \
    chmod -R 755 temp-uploads attached_assets logs

# إنشاء مستخدم آمن
RUN addgroup -g 1001 -S nodejs && \
    adduser -S appuser -u 1001 -G nodejs && \
    chown -R appuser:nodejs /app

# التبديل للمستخدم الآمن
USER appuser

# كشف المنفذ
EXPOSE 3000

# فحص صحة التطبيق
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# أمر التشغيل مع حل مسارات TypeScript محلياً
CMD ["npx", "tsx", "--require", "tsconfig-paths/register", "server/index.ts"]